<refentry xml:id="function.end" xmlns="http://docbook.org/ns/docbook">
 <refnamediv>
  <refname>end</refname>
  <refpurpose>एउटा array को internal pointer लाई त्यसको अन्तिम element मा set गर्दछ</refpurpose>
 </refnamediv>
 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>mixed</type><methodname>end</methodname>
   <methodparam><type class="union"><type>array</type><type>object</type></type><parameter role="reference">array</parameter></methodparam>
  </methodsynopsis>
  <para><function>end</function> ले <parameter>array</parameter> को internal pointer लाई अन्तिम element मा अगाडि बढाउँछ, र त्यसको value return गर्दछ।</para>
 </refsect1>
 <refsect1 role="parameters">
  &reftitle.parameters;
  <para>
   <variablelist>
    <varlistentry>
     <term><parameter>array</parameter></term>
     <listitem>
      <para>array। यो array लाई reference मार्फत pass गरिन्छ किनभने यसलाई function ले परिमार्जन गर्दछ। यसको अर्थ तपाईँले यसमा एउटा वास्तविक variable नै pass गर्नुपर्छ, array return गर्ने function होइन; किनकि केवल वास्तविक variables लाई मात्र reference मार्फत pass गर्न सकिन्छ।</para>
     </listitem>
    </varlistentry>
   </variablelist>
  </para>
 </refsect1>
 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>अन्तिम element को value वा खाली array का लागि &false; return गर्दछ।</para>
 </refsect1>

 <refsect1 role="changelog">
  &reftitle.changelog;
  <informaltable>
   <tgroup cols="2">
    <thead>
     <row>
      <entry>&Version;</entry>
      <entry>&Description;</entry>
     </row>
    </thead>
    <tbody>
     &standard.changelog.calling-on-objects;
    </tbody>
   </tgroup>
  </informaltable>
 </refsect1>
 
 <refsect1 role="examples">
  &reftitle.examples;
  <para>
   <example>
    <title><function>end</function> को उदाहरण</title>
    <programlisting role="php">
<![CDATA[
<?php

$fruits = array('apple', 'banana', 'cranberry');
echo end($fruits); // cranberry

?>
]]>
    </programlisting>
   </example>
  </para>
 </refsect1>
 <refsect1 role="seealso">
  &reftitle.seealso;
