  &reftitle.seealso;
  <para>
   <simplelist>
    <member><function>array_intersect_assoc</function></member>
    <member><function>array_diff</function></member>
    <member><function>array_diff_assoc</function></member>
   </simplelist>
  </para>
 </refsect1>
</refentry>

