<refentry xmlns="http://docbook.org/ns/docbook" xml:id="function.array-pop">
 <refnamediv>
  <refname>array_pop</refname>
  <refpurpose>array को end बाट element pop गर्दछ</refpurpose>
 </refnamediv>
 
 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>mixed</type><methodname>array_pop</methodname>
   <methodparam><type>array</type><parameter role="reference">array</parameter></methodparam>
  </methodsynopsis>
  <para><function>array_pop</function> ले <parameter>array</parameter> को अन्तिम element को value pop गरेर return गर्दछ, र <parameter>array</parameter> लाई एक element ले छोट्याउँछ।</para>
  &array.resetspointer;
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <para>
   <variablelist>
    <varlistentry>
     <term><parameter>array</parameter></term>
     <listitem>
      <para>array, जस from value प्राप्त गरिन्छ।</para>
     </listitem>
    </varlistentry>
   </variablelist>
  </para>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para><parameter>array</parameter> को अन्तिम element को value return गर्दछ। यदि <parameter>array</parameter> empty छ भने, &null; return हुनेछ।</para>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <para>
   <example>
    <title><function>array_pop</function> को उदाहरण</title>
    <programlisting role="php">
<![CDATA[
<?php
$stack = array("orange", "banana", "apple", "raspberry");
$fruit = array_pop($stack);
print_r($stack);
?>
]]>
    </programlisting>
    <para>यसपछि, <varname>$stack</varname> मा केवल 3 वटा elements हुनेछन्:</para>
    <screen role="php">
<![CDATA[
Array
(
    [0] => orange
    [1] => banana
    [2] => apple
)
]]>
    </screen>
    <para>र <literal>raspberry</literal> लाई <varname>$fruit</varname> मा assign गरिनेछ।</para>
   </example>
  </para>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member><function>array_push</function></member>
    <member><function>array_shift</function></member>
    <member><function>array_unshift</function></member>
   </simplelist>
  </para>
 </refsect1>
</refentry>

