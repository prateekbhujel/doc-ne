<refentry xmlns="http://docbook.org/ns/docbook" xml:id="function.strrev">
 <refnamediv>
  <refname>strrev</refname>
  <refpurpose>एउटा string reverse गर्छ</refpurpose>
 </refnamediv>
 
 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>string</type><methodname>strrev</methodname>
   <methodparam><type>string</type><parameter>string</parameter></methodparam>
  </methodsynopsis>
  <para>Reverse गरिएको <parameter>string</parameter> return गर्दछ।</para>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <para>
   <variablelist>
    <varlistentry>
     <term><parameter>string</parameter></term>
     <listitem>
      <para>Reverse गरिने string।</para>
     </listitem>
    </varlistentry>
   </variablelist>
  </para>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>उल्ट्याइएको string return गर्दछ।</para>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <para>
   <example>
    <title><function>strrev</function> प्रयोग गरेर एउटा string reverse गर्ने</title>
    <programlisting role="php">
<![CDATA[
<?php
echo strrev("Hello world!"); // outputs "!dlrow olleH"
?>
]]>
    </programlisting>
   </example>
  </para>   
 </refsect1>

</refentry>

