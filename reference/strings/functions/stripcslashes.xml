<refentry xml:id="function.stripcslashes" xmlns="http://docbook.org/ns/docbook">
 <refnamediv>
  <refname>stripcslashes</refname>
  <refpurpose><function>addcslashes</function> ले quote गरिएको string लाई un-quote गर्दछ</refpurpose>
 </refnamediv>
 
 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>string</type><methodname>stripcslashes</methodname>
   <methodparam><type>string</type><parameter>string</parameter></methodparam>
  </methodsynopsis>
  <para>Backslashes हटाइएको एउटा string return गर्दछ। यसले C-like <literal>\n</literal>, <literal>\r</literal> ..., octal र hexadecimal representation पहिचान गर्दछ।</para>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <para>
   <variablelist>
    <varlistentry>
     <term><parameter>string</parameter></term>
     <listitem>
      <para>Unescape गरिनुपर्ने string।</para>
     </listitem>
    </varlistentry>
   </variablelist>
  </para>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>Unescape गरिएको string return गर्दछ।</para>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <para>
   <example>
    <title><function>stripcslashes</function> को उदाहरण</title>
    <programlisting role="php">
<![CDATA[
<?php

var_dump(stripcslashes('I\'d have a coffee.\nNot a problem.') === "I'd have a coffee.
Not a problem."); // true
?>
]]>
    </programlisting>
   </example>
  </para>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member><function>addcslashes</function></member>
   </simplelist>
  </para>
 </refsect1>

</refentry>
