<refentry xmlns="http://docbook.org/ns/docbook" xml:id="function.nl2br">
 <refnamediv>
  <refname>nl2br</refname>
  <refpurpose>एउटा string का सबै newlines अघि HTML line breaks insert गर्दछ</refpurpose>
 </refnamediv>
 
 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>string</type><methodname>nl2br</methodname>
   <methodparam><type>string</type><parameter>string</parameter></methodparam>
   <methodparam choice="opt"><type>bool</type><parameter>use_xhtml</parameter><initializer>&true;</initializer></methodparam>
  </methodsynopsis>
  <para>सबै newlines (<literal>\r\n</literal>, <literal>\n\r</literal>, <literal>\n</literal> र <literal>\r</literal>) अघि <code>&lt;br /&gt;</code> वा <code>&lt;br&gt;</code> insert गरिएको <parameter>string</parameter> return गर्दछ।</para>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <para>
   <variablelist>
    <varlistentry>
     <term><parameter>string</parameter></term>
     <listitem>
      <para>Input string।</para>
     </listitem>
    </varlistentry>
    <varlistentry>
     <term><parameter>use_xhtml</parameter></term>
     <listitem>
      <para>XHTML compatible line breaks प्रयोग गर्ने कि नगर्ने।</para>
     </listitem>
    </varlistentry>
   </variablelist>
  </para>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>परिवर्तन गरिएको string return गर्दछ।</para>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <para>
   <example>
    <title><function>nl2br</function> को प्रयोग</title>
    <programlisting role="php">
<![CDATA[
<?php
echo nl2br("foo isn't\n bar");
?>
]]>
    </programlisting>
    &example.outputs;
    <screen>
<![CDATA[
foo isn't<br />
 bar
]]>
    </screen>
   </example>
   <example>
    <title><parameter>use_xhtml</parameter> parameter प्रयोग गरेर मान्य HTML markup generate गर्ने</title>
    <programlisting role="php">
<![CDATA[
<?php
echo nl2br("Welcome\r\nThis is my HTML document", false);
?>
]]>
    </programlisting>
    &example.outputs;
    <screen>
<![CDATA[
Welcome<br>
This is my HTML document
]]>
    </screen>
   </example>
   <example>
    <title>विभिन्न newline separators</title>
    <programlisting role="php">
<![CDATA[
<?php
$string = "This\r\nis\n\ra\nstring\r";
echo nl2br($string);
?>
]]>
    </programlisting>
    &example.outputs;
    <screen>
<![CDATA[
This<br />
is<br />
a<br />
string<br />
]]>
    </screen>
   </example>
  </para>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member><function>htmlspecialchars</function></member>
    <member><function>htmlentities</function></member>
    <member><function>wordwrap</function></member>
    <member><function>str_replace</function></member>
   </simplelist>
  </para>
 </refsect1>

</refentry>
