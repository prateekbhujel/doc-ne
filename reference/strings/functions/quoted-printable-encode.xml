<refentry xmlns:xlink="http://www.w3.org/1999/xlink" xmlns="http://docbook.org/ns/docbook" xml:id="function.quoted-printable-encode">
 <refnamediv>
  <refname>quoted_printable_encode</refname>
  <refpurpose>एउटा 8 bit string लाई quoted-printable string मा convert गर्दछ</refpurpose>
 </refnamediv>
 
 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>string</type><methodname>quoted_printable_encode</methodname>
   <methodparam><type>string</type><parameter>string</parameter></methodparam>
  </methodsynopsis>
  <para><link
   xlink:href="&url.rfc;2045">RFC2045</link> को section 6.7 अनुसार सिर्जना गरिएको quoted printable string return गर्दछ।</para>
  <para>यो function <function>imap_8bit</function> सँग मिल्दोजुल्दो छ, तर यसलाई काम गर्न IMAP module आवश्यक पर्दैन।</para>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <para>
   <variablelist>
    <varlistentry>
     <term><parameter>string</parameter></term>
     <listitem>
      <para>Input string।</para>
     </listitem>
    </varlistentry>
   </variablelist>
  </para>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>Encode गरिएको string return गर्दछ।</para>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <para>
   <example>
    <title><function>quoted_printable_encode</function> को उदाहरण</title>
    <programlisting role="php">
<![CDATA[
<?php

$encoded = quoted_printable_encode('Möchten Sie ein paar Äpfel?');

var_dump($encoded);
var_dump(quoted_printable_decode($encoded));
?>
]]>
    </programlisting>
    &example.outputs;
    <screen>
<![CDATA[
string(37) "M=C3=B6chten Sie ein paar =C3=84pfel?"
string(29) "Möchten Sie ein paar Äpfel?"
]]>
    </screen>
   </example>
  </para>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member><function>quoted_printable_decode</function></member>
    <member><function>iconv_mime_encode</function></member>
   </simplelist>
  </para>
 </refsect1>

</refentry>
