<refentry xmlns:xlink="http://www.w3.org/1999/xlink" xmlns="http://docbook.org/ns/docbook" xml:id="function.sha1">
 <refnamediv>
  <refname>sha1</refname>
  <refpurpose>एउटा string को sha1 hash गणना गर्दछ</refpurpose>
 </refnamediv>
 
 <refsynopsisdiv>
  &warn.passwordhashing;
 </refsynopsisdiv>
 
 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>string</type><methodname>sha1</methodname>
   <methodparam><type>string</type><parameter>string</parameter></methodparam>
   <methodparam choice="opt"><type>bool</type><parameter>binary</parameter><initializer>&false;</initializer></methodparam>
  </methodsynopsis>
  <simpara><link xlink:href="&url.rfc;3174">US Secure Hash Algorithm 1</link> को प्रयोग गरी <parameter>string</parameter> को sha1 hash गणना गर्दछ।</simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <para>
   <variablelist>
    <varlistentry>
     <term><parameter>string</parameter></term>
     <listitem>
      <para>Input string।</para>
     </listitem>
    </varlistentry>
    <varlistentry>
     <term><parameter>binary</parameter></term>
     <listitem>
      <para>यदि वैकल्पिक <parameter>binary</parameter> लाई &true; मा set गरिएको छ भने, sha1 digest यसको सट्टा २० लम्बाइ भएको raw binary format मा return गरिन्छ, अन्यथा return हुने value एउटा ४०-character hexadecimal number हुन्छ।</para>
     </listitem>
    </varlistentry>
   </variablelist>
  </para>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>sha1 hash लाई एउटा string को रूपमा return गर्दछ।</para>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <para>
   <example>
    <title>एउटा <function>sha1</function> उदाहरण</title>
    <programlisting role="php">
<![CDATA[
<?php
$str = 'apple';

if (sha1($str) === 'd0be2dc421be4fcd0172e5afceea3970e2f3d940') {
    echo "Would you like a green or red apple?";
}
?>
]]>
    </programlisting>
   </example>
  </para>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member><function>hash</function></member>
    <member><function>password_hash</function></member>
   </simplelist>
  </para>
 </refsect1>

</refentry>
