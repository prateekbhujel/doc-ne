<refentry xmlns="http://docbook.org/ns/docbook" xml:id="function.str-decrement">
 <refnamediv>
  <refname>str_decrement</refname>
  <refpurpose>एउटा alphanumeric string लाई decrement गर्ने</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>string</type><methodname>str_decrement</methodname>
   <methodparam><type>string</type><parameter>string</parameter></methodparam>
  </methodsynopsis>
  <para>decrement गरिएको alphanumeric <acronym>ASCII</acronym> <parameter>string</parameter> return गर्दछ।</para>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <para>
   <variablelist>
    <varlistentry>
     <term><parameter>string</parameter></term>
     <listitem>
      <para>Input string।</para>
     </listitem>
    </varlistentry>
   </variablelist>
  </para>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>decrement गरिएको alphanumeric <acronym>ASCII</acronym> string return गर्दछ।</para>
 </refsect1>

 <refsect1 role="errors">
  &reftitle.errors;
  <para>यदि <parameter>string</parameter> खाली छ भने एउटा <classname>ValueError</classname> throw गरिन्छ।</para>
  <para>यदि <parameter>string</parameter> एउटा alphanumeric <acronym>ASCII</acronym> string होइन भने <classname>ValueError</classname> throw गरिन्छ।</para>
  <para>यदि <parameter>string</parameter> लाई decrement गर्न सकिएन भने <classname>ValueError</classname> throw गरिन्छ। उदाहरणका लागि, <literal>"A"</literal> वा <literal>"0"</literal>।</para>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <para>
   <example>
    <title><function>str_decrement</function> को आधारभूत उदाहरण</title>
    <programlisting role="php">
<![CDATA[
<?php
$str = 'ABC';
var_dump(str_decrement($str));
?>
]]>
    </programlisting>
    &example.outputs;
    <screen>
<![CDATA[
string(3) "ABB"
]]>
    </screen>
   </example>
  </para>
  <para>
   <example>
    <title>carry सहितको <function>str_decrement</function> उदाहरण</title>
    <programlisting role="php">
<![CDATA[
<?php
$str = 'ZA';
var_dump(str_decrement($str));

$str = 'AA';
var_dump(str_decrement($str));
?>
]]>
    </programlisting>
    &example.outputs;
    <screen>
<![CDATA[
string(2) "YZ"
string(1) "Z"
]]>
    </screen>
   </example>
  </para>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member><function>str_increment</function></member>
   </simplelist>
  </para>
 </refsect1>

</refentry>
