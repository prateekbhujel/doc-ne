<refentry xmlns="http://docbook.org/ns/docbook" xml:id="function.str-rot13">
 <refnamediv>
  <refname>str_rot13</refname>
  <refpurpose>एउटा string मा rot13 transform गर्दछ</refpurpose>
 </refnamediv>
 
 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>string</type><methodname>str_rot13</methodname>
   <methodparam><type>string</type><parameter>string</parameter></methodparam>
  </methodsynopsis>
  <para><parameter>string</parameter> argument मा ROT13 encoding गर्दछ र नतिजा स्वरूप प्राप्त हुने string return गर्दछ।</para>
  <para>ROT13 encoding ले non-alpha characters लाई नछोई alphabet का प्रत्येक अक्षरलाई केवल १३ स्थानले सार्छ। Encoding र decoding एउटै function बाट गरिन्छ, र encoded string लाई argument को रूपमा पास गर्दा यसले original version return गर्दछ।</para>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <para>
   <variablelist>
    <varlistentry>
     <term><parameter>string</parameter></term>
     <listitem>
      <para>Input string।</para>
     </listitem>
    </varlistentry>
   </variablelist>
  </para>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>दिइएको string को ROT13 version return गर्दछ।</para>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <para>
   <example>
    <title><function>str_rot13</function> को उदाहरण</title>
    <programlisting role="php">
<![CDATA[
<?php

echo str_rot13('PHP 4.3.0'); // CUC 4.3.0

?>
]]>
    </programlisting>
   </example>
  </para>
 </refsect1>

</refentry>
