<refentry xmlns:xlink="http://www.w3.org/1999/xlink" xmlns="http://docbook.org/ns/docbook" xml:id="function.sha1-file">
 <refnamediv>
  <refname>sha1_file</refname>
  <refpurpose>एउटा file को sha1 hash गणना गर्दछ</refpurpose>
 </refnamediv>
 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type class="union"><type>string</type><type>false</type></type><methodname>sha1_file</methodname>
   <methodparam><type>string</type><parameter>filename</parameter></methodparam>
   <methodparam choice="opt"><type>bool</type><parameter>binary</parameter><initializer>&false;</initializer></methodparam>
  </methodsynopsis>
  <simpara><link xlink:href="&url.rfc;3174">US Secure Hash Algorithm 1</link> प्रयोग गरेर <parameter>filename</parameter> द्वारा तोकिएको file को sha1 hash गणना गर्दछ, र उक्त hash return गर्दछ। उक्त hash एउटा 40-character hexadecimal number हो।</simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <para>
   <variablelist>
    <varlistentry>
     <term><parameter>filename</parameter></term>
     <listitem>
      <para>hash गरिने file को filename।</para>
     </listitem>
    </varlistentry>
    <varlistentry>
     <term><parameter>binary</parameter></term>
     <listitem>
      <para>&true; हुँदा, 20 length भएको raw binary format मा digest return गर्दछ।</para>
     </listitem>
    </varlistentry>
   </variablelist>
  </para>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>सफलतामा string, अन्यथा &false; return गर्दछ।</para>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <para>
   <example>
    <title><function>sha1_file</function> को उदाहरण</title>
    <programlisting role="php">
<![CDATA[
<?php
foreach (glob('/examples/*.xml') as $ent)
{
    if (is_dir($ent)) {
        continue;
    }

    echo $ent . ' (SHA1: ' . sha1_file($ent) . ')', PHP_EOL;
}
?>
]]>
    </programlisting>
   </example>
  </para>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member><function>hash_file</function></member>
    <member><function>hash_init</function></member>
    <member><function>sha1</function></member>
   </simplelist>
  </para>
 </refsect1>
</refentry>
