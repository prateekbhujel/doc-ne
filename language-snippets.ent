<!ENTITY installation.enabled.disable 'यो extension डिफल्ट रूपमा सक्षम (enabled) गरिएको हुन्छ। यसलाई compile गर्दा निम्न विकल्प दिएर अक्षम (disable) गर्न सकिन्छ: '>

<!ENTITY array.changelog.by-ref '<row xmlns="http://docbook.org/ns/docbook">
 <entry>8.0.0</entry>
 <entry>
  यदि <parameter>callback</parameter> ले कुनै parameter लाई reference द्वारा pass गरिने अपेक्षा गर्छ भने, यस function ले अब एउटा <constant>E_WARNING</constant> जारी गर्नेछ।
 </entry>
</row>'>

<!ENTITY array.changelog.require-only-one '<row xmlns="http://docbook.org/ns/docbook">
  <entry>8.0.0</entry>
  <entry>
  यस function लाई अब एउटा मात्र parameter दिएर call गर्न सकिन्छ।
  यसअघि कम्तीमा दुईवटा parameters आवश्यक पर्दथ्यो।
  </entry>
</row>'>

<!ENTITY array.resetspointer '<note xmlns="http://docbook.org/ns/docbook"><simpara>यस function ले प्रयोगपछि इनपुट array को <type>array</type> pointer लाई <function>reset</function> गर्नेछ।</simpara></note>'>

<!-- Cautions -->
<!ENTITY caution.cryptographically-insecure '<caution xmlns="http://docbook.org/ns/docbook"><para>यो function ले cryptographically secure value उत्पन्न गर्दैन, त्यसैले यसलाई सुरक्षा वा क्रिप्टोग्राफी सम्बन्धी प्रयोजनमा प्रयोग गर्नु हुँदैन। यदि cryptographically secure value चाहिने हो भने <function>random_int</function>, <function>random_bytes</function>, वा <function>openssl_random_pseudo_bytes</function> प्रयोग गर्नुहोस्।</para></caution>'>

<!ENTITY caution.mt19937-global-state '<caution xmlns="http://docbook.org/ns/docbook">
 <simpara>
    यस function ले randomness को स्रोतका रूपमा global Mt19937 (“Mersenne Twister”) instance प्रयोग गर्दछ र त्यसैले global Mt19937 प्रयोग गर्ने अन्य सबै functions सँग आफ्नो state साझा गर्दछ।
    यीमध्ये कुनै पनि function प्रयोग गर्दा scope जुनसुकै भए पनि अन्य <emphasis>सबै</emphasis> functions का लागि sequence अगाडि बढ्छ।
  </simpara>
  <simpara>
    कुनै निश्चित value दिएर <function>mt_srand</function> वा <function>srand</function> लाई seed गरी दोहोरिने sequences उत्पन्न गर्दा यस function बाट पनि दोहोरिने (repeatable) output नै प्राप्त हुनेछ।
  </simpara>
  <simpara>
    नयाँ लेखिने सबै code मा <classname>Random\Randomizer</classname> का methods प्रयोग गर्नु उपयुक्त हुन्छ।
 </simpara>
</caution>'>

