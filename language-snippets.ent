<!ENTITY warn.install.cgi '<warning xmlns="http://docbook.org/ns/docbook"><simpara>CGI मोडमा परिनियोजन (deploy) गरिएको server विभिन्न सम्भावित सुरक्षा कमजोरीहरूका लागि खुला हुन्छ। यस्ता आक्रमणहरूबाट कसरी बच्ने भनी जान्नका लागि कृपया हाम्रो <link linkend="security.cgi-bin">CGI सुरक्षा खण्ड</link> पढ्नुहोस्।</simpara></warning>'>

<!ENTITY warn.install.third-party-support '<warning xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <simpara>
  तेस्रो-पक्ष (third-parties) बाट प्राप्त builds लाई अनौपचारिक मानिन्छ र PHP परियोजनाद्वारा प्रत्यक्ष समर्थन गरिँदैन। त्यस्ता अनौपचारिक builds मा भेटिएका कुनै पनि त्रुटिहरू (bugs) यदि <link xlink:href="&url.php.downloads;">आधिकारिक डाउनलोड क्षेत्र</link> का builds मा पुनः उत्पन्न (reproduce) गर्न सकिँदैन भने ती अनौपचारिक builds का प्रदायकलाई नै रिपोर्ट गर्नुपर्छ।
 </simpara>
</warning>'>

<!ENTITY warn.passwordhashing '<warning xmlns="http://docbook.org/ns/docbook">
 <simpara>
  यस hashing एल्गोरिदमको तीव्र प्रकृतिका कारण पासवर्डहरू सुरक्षित राख्न यो function प्रयोग गर्न सिफारिस गरिँदैन। विस्तृत विवरण र उत्तम अभ्यासहरूका लागि <link linkend="faq.passwords.fasthash">Password Hashing FAQ</link> हेर्नुहोस्।
 </simpara>
</warning>'>

<!ENTITY warning.csv.escape-parameter '<warning xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink"><simpara>
 जब <parameter>escape</parameter> लाई खाली string (<literal>""</literal>) बाहेक अन्य कुनै कुरामा सेट गरिन्छ, यसले <link xlink:href="&url.rfc;4180">RFC 4180</link> को पालना नगर्ने वा PHP CSV functions मार्फत roundtrip पार गर्न नसक्ने CSV निम्त्याउन सक्छ। <parameter>escape</parameter> को डिफल्ट मान <literal>"\\"</literal> हो, त्यसैले यसलाई स्पष्ट रूपमा खाली string मा सेट गर्न सिफारिस गरिन्छ। डिफल्ट value PHP को भावी संस्करणमा (PHP 9.0 भन्दा पहिले होइन) परिवर्तन हुनेछ।
</simpara></warning>'>
