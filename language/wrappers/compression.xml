<refentry xml:id="wrappers.compression" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" annotations="verify_info:false" role="stream_wrapper">
 <refnamediv>
  <refname>zlib://</refname>
  <refname>bzip2://</refname>
  <refname>zip://</refname>
  <refpurpose>Compression Streams</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <simpara><filename>compress.zlib://</filename> र <filename>compress.bzip2://</filename></simpara>

  <simpara>
   <filename>zlib:</filename> ले <function>gzopen</function> जस्तै काम गर्छ,
   तर यसको stream लाई <function>fread</function> र अन्य filesystem functions
   सँग प्रयोग गर्न सकिन्छ। ':' अक्षर समावेश भएका filenames सँग अस्पष्टता (ambiguities)
   आउने भएकाले यो deprecated गरिएको छ; यसको सट्टा
   <filename>compress.zlib://</filename> प्रयोग गर्नुहोस्।
  </simpara>

  <simpara>
   <filename>compress.zlib://</filename> र
   <filename>compress.bzip2://</filename> क्रमशः
   <function>gzopen</function> र <function>bzopen</function> सरह नै हुन्, र
   fopencookie समर्थन नगर्ने systems मा समेत काम गर्छन्।
  </simpara>

  <simpara>
   <link linkend="book.zip">ZIP extension</link> ले <filename>zip:</filename>
   wrapper register गर्छ। PHP 7.2.0 र libzip 1.2.0+ देखि encrypted archives
   का लागि password को समर्थन थपिएको छ, जसले stream contexts मार्फत passwords
   दिन अनुमति दिन्छ। <literal>'password'</literal> stream context option प्रयोग
   गरेर passwords सेट गर्न सकिन्छ।
  </simpara>
 </refsect1>

 <refsect1 role="usage">
  &reftitle.usage;
  <itemizedlist>
   <listitem><simpara><filename>compress.zlib://file.gz</filename></simpara></listitem>
   <listitem><simpara><filename>compress.bzip2://file.bz2</filename></simpara></listitem>
   <listitem><simpara><filename>zip://archive.zip#dir/file.txt</filename></simpara></listitem>
  </itemizedlist>
 </refsect1>

 <refsect1 role="options">
  &reftitle.options;
  <para>
   <table>
    <title>Wrapper सारांश</title>
    <tgroup cols="2">
     <thead>
      <row>
       <entry>विशेषता (Attribute)</entry>
       <entry>समर्थित (Supported)</entry>
      </row>
     </thead>
     <tbody>
      <row>
       <entry><link linkend="ini.allow-url-fopen">allow_url_fopen</link> द्वारा सीमित</entry>
       <entry>छैन</entry>
      </row>
      <row>
       <entry>Read गर्ने अनुमति</entry>
       <entry>छ</entry>
      </row>
      <row>
       <entry>Write गर्ने अनुमति</entry>
       <entry>छ (<literal>zip://</literal> बाहेक)</entry>
      </row>
      <row>
       <entry>Append गर्ने अनुमति</entry>
       <entry>छ (<literal>zip://</literal> बाहेक)</entry>
      </row>
      <row>
       <entry>एकैसाथ Read र Write गर्ने अनुमति</entry>
       <entry>छैन</entry>
      </row>
      <row>
       <entry><function>stat</function> समर्थन</entry>
       <entry>
        छैन, compressed files लाई stat गर्न सामान्य <literal>file://</literal>
        wrapper प्रयोग गर्नुहोस्।
       </entry>
      </row>
      <row>
       <entry><function>unlink</function> समर्थन</entry>
       <entry>
        छैन, compressed files लाई unlink गर्न सामान्य <literal>file://</literal>
        wrapper प्रयोग गर्नुहोस्।
       </entry>
      </row>
      <row>
       <entry><function>rename</function> समर्थन</entry>
       <entry>छैन</entry>
      </row>
      <row>
       <entry><function>mkdir</function> समर्थन</entry>
       <entry>छैन</entry>
      </row>
      <row>
       <entry><function>rmdir</function> समर्थन</entry>
       <entry>छैन</entry>
      </row>
     </tbody>
    </tgroup>
   </table>
  </para>
 </refsect1>

