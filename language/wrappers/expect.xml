<refentry xml:id="wrappers.expect" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" annotations="verify_info:false" role="stream_wrapper">
 <refnamediv>
  <refname>expect://</refname>
  <refpurpose>Process Interaction Streams</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <simpara>
   <filename>expect://</filename> wrapper मार्फत खोलिएका streams ले PTY
   मार्फत process को stdin, stdout र stderr मा पहुँच प्रदान गर्छन्।
  </simpara>
  <note>
   <title>यो wrapper डिफल्ट रूपमा सक्षम (enabled) हुँदैन</title>
   <simpara>
    <filename>expect://</filename> wrapper प्रयोग गर्नका लागि,
    &link.pecl; बाट उपलब्ध
    <link xlink:href="&url.pecl.package;expect">Expect</link>
    extension install गरिएको हुनुपर्छ।
   </simpara>
  </note>
  <simpara><filename>expect://</filename> (PECL)</simpara>
 </refsect1>

 <refsect1 role="usage">
  &reftitle.usage;
  <itemizedlist>
   <listitem><simpara><filename>expect://command</filename></simpara></listitem>
  </itemizedlist>
 </refsect1>

