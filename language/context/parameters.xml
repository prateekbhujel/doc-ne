<refentry xml:id="context.params" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" annotations="verify_info:false" role="stream_context_option">
 <refnamediv>
  <refname>Context parameters</refname>
  <refpurpose>Context parameters को सूची</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <para>
   <function>stream_context_set_params</function> function प्रयोग गरेर
   कुनै <literal>context</literal> मा यी <literal>parameters</literal> सेट
   गर्न सकिन्छ।
  </para>
 </refsect1>

 <refsect1 role="options">
  &reftitle.parameters;
  <para>
   <variablelist>
    <varlistentry xml:id="context.params.notification">
     <term>
      <parameter>notification</parameter>
      <type>callable</type>
     </term>
     <listitem>
      <para>
       Stream मा कुनै event हुँदा call गरिने <type>callable</type>।
      </para>
      <para>
       थप विवरणका लागि <link linkend="function.stream-notification-callback">
       stream_notification_callback</link> हेर्नुहोस्।
      </para>
     </listitem>
    </varlistentry>
   </variablelist>
  </para>
 </refsect1>

</refentry>

