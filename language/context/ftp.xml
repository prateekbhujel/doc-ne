<refentry xml:id="context.ftp" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" annotations="verify_info:false" role="stream_context_option">
 <refnamediv>
  <refname>FTP context options</refname>
  <refpurpose>FTP context options को सूची</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <para>
   <literal>ftp://</literal> र <literal>ftps://</literal> transports का लागि
   context options।
  </para>
 </refsect1>

 <refsect1 role="options">
  &reftitle.options;
  <para>
   <variablelist>
    <varlistentry xml:id="context.ftp.overwrite">
     <term>
      <parameter>overwrite</parameter>
      <type>bool</type>
     </term>
     <listitem>
      <para>
       Remote server मा पहिले नै रहेका files लाई overwrite गर्न अनुमति दिन्छ।
       यो write mode (uploading) मा मात्र लागू हुन्छ।
      </para>
      <para>
       डिफल्ट मान &false; हुन्छ।
      </para>
     </listitem>
    </varlistentry>
    <varlistentry xml:id="context.ftp.resume-pos">
     <term>
      <parameter>resume_pos</parameter>
      <type>int</type>
     </term>
     <listitem>
      <para>
       Transfer सुरु गरिने file offset। यो read mode (downloading) मा मात्र लागू हुन्छ।
      </para>
      <para>
       डिफल्ट मान <literal>0</literal> (file को सुरुवात) हुन्छ।
      </para>
     </listitem>
    </varlistentry>
    <varlistentry xml:id="context.ftp.proxy">
     <term>
      <parameter>proxy</parameter>
      <type>string</type>
     </term>
     <listitem>
      <para>
       HTTP proxy server मार्फत FTP request लाई proxy गर्छ। यो file read
       operations मा मात्र लागू हुन्छ। उदाहरण: <literal>tcp://squid.example.com:8000</literal>।
      </para>
     </listitem>
    </varlistentry>
   </variablelist>
  </para>
 </refsect1>

 <refsect1 role="notes">
  &reftitle.notes;
  <note>
   <title>Underlying socket stream context options</title>
   <simpara>
    <link linkend="transports.inet">Underlying transport</link> ले थप
    context options समर्थन गरेको हुन सक्छ। <literal>ftp://</literal> streams
    का लागि <literal>tcp://</literal> transport का context options हेर्नुहोस्।
    <literal>ftps://</literal> streams का लागि <literal>ssl://</literal>
    transport का context options हेर्नुहोस्।
   </simpara>
  </note>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member><xref linkend="wrappers.ftp" /></member>
    <member><xref linkend="context.socket" /></member>
    <member><xref linkend="context.ssl" /></member>
   </simplelist>
  </para>
 </refsect1>

</refentry>

