<refentry xml:id="sensitiveparametervalue.debuginfo" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>SensitiveParameterValue::__debugInfo</refname>
  <refpurpose>संवेदनशील value लाई अनजानवश expose हुनबाट जोगाउँछ</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="SensitiveParameterValue">
   <modifier>public</modifier> <type>array</type><methodname>SensitiveParameterValue::__debugInfo</methodname>
   <void/>
  </methodsynopsis>
  <para><function>var_dump</function> प्रयोग गर्दा संवेदनशील value लाई अनजानवश expose हुनबाट जोगाउन एउटा खाली &array; return गर्दछ।</para>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>एउटा खाली &array;।</para>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <para>
   <example>
    <title><function>var_dump</function> मा एउटा <classname>SensitiveParameterValue</classname> object pass गर्ने</title>
    <programlisting role="php">
<![CDATA[
<?php
$s = new \SensitiveParameterValue('secret');

var_dump($s);
?>
]]>
    </programlisting>
    &example.outputs;
    <screen>
<![CDATA[
object(SensitiveParameterValue)#1 (0) {
}
]]>
    </screen>
   </example>
  </para>
 </refsect1>

</refentry>
