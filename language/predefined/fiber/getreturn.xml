<refentry xml:id="fiber.getreturn" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Fiber::getReturn</refname>
  <refpurpose>Fiber ले return गरेको value प्राप्त गर्छ</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="Fiber">
   <modifier>public</modifier> <type>mixed</type><methodname>Fiber::getReturn</methodname>
   <void/>
  </methodsynopsis>
  <simpara>
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para><methodname>Fiber::__construct</methodname> मा दिइएको <type>callable</type> ले return गरेको value return गर्छ। यदि fiber ले कुनै value return गरेको छैन भने, चाहे त्यो सुरु नभएकोले होस्, terminate नभएकोले होस्, वा कुनै exception throw गरेको हुनाले होस्, एउटा <exceptionname>FiberError</exceptionname> throw हुनेछ।</para>
 </refsect1>

</refentry>
