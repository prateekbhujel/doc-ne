<refentry xml:id="fiber.start" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Fiber::start</refname>
  <refpurpose>fiber को execution सुरु गर्छ</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="Fiber">
   <modifier>public</modifier> <type>mixed</type><methodname>Fiber::start</methodname>
   <methodparam rep="repeat"><type>mixed</type><parameter>args</parameter></methodparam>
  </methodsynopsis>
  <simpara>fiber construct गर्दा प्रयोग गरिएको callable लाई दिइने arguments को एउटा variadic list।</simpara>
  <simpara>यदि यो method call गर्दा fiber पहिले नै सुरु भइसकेको छ भने, एउटा <exceptionname>FiberError</exceptionname> throw हुनेछ।</simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>args</parameter></term>
    <listitem>
     <simpara>fiber constructor मा दिइएको callable लाई invoke गर्दा प्रयोग गरिने arguments।</simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para><methodname>Fiber::suspend</methodname> को पहिलो call मा दिइएको value, वा यदि fiber return हुन्छ भने &null;। यदि fiber ले suspend हुनुअघि कुनै exception throw गर्छ भने, त्यो यस method को call बाट from throw हुनेछ।</para>
 </refsect1>

</refentry>
