<refentry xml:id="weakreference.get" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>WeakReference::get</refname>
  <refpurpose>Weakly referenced Object प्राप्त गर्छ</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="WeakReference">
   <modifier>public</modifier> <type class="union"><type>object</type><type>null</type></type><methodname>WeakReference::get</methodname>
   <void/>
  </methodsynopsis>
  <para>Weakly referenced object प्राप्त गर्छ। यदि object पहिले नै नष्ट भइसकेको छ भने, &null; return हुन्छ।</para>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>Referenced &object; return गर्दछ, वा यदि object नष्ट भइसकेको छ भने &null; return गर्दछ।</para>
 </refsect1>

</refentry>
