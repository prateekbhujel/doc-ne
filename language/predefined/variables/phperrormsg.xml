<refentry role="variable" xml:id="reserved.variables.phperrormsg" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>$php_errormsg</refname>
  <refpurpose>अघिल्लो error message</refpurpose>
 </refnamediv>

 <refsynopsisdiv>
  &warn.deprecated.feature-7-2-0.removed-8-0-0;
  <simpara>
   यसको सट्टा <function>error_get_last</function> प्रयोग गर्नुहोस्।
  </simpara>
 </refsynopsisdiv>

 <refsect1 role="description">
  &reftitle.description;
  <para>
   <varname>$php_errormsg</varname> एउटा variable हो जसमा PHP ले उत्पन्न गरेको
   पछिल्लो error message को text हुन्छ। यो variable केवल त्यही scope भित्र मात्र
   उपलब्ध हुन्छ जहाँ error आएको थियो, र त्यो पनि तब मात्र जब
   <link linkend="ini.track-errors">track_errors</link> configuration option
   अन (on) गरिएको हुन्छ (यो डिफल्ट रूपमा off हुन्छ)।
  </para>
  <warning>
   <simpara>
    यदि प्रयोगकर्ता-परिभाषित (user-defined) error handler
    (<function>set_error_handler</function>) सेट गरिएको छ भने, उक्त error
    handler ले &false; return गरेको अवस्थामा मात्र
    <varname>$php_errormsg</varname> सेट हुन्छ।
   </simpara>
  </warning>
 </refsect1>

 <refsect1 role="changelog">
  &reftitle.changelog;
  <para>
   <informaltable>
    <tgroup cols="2">
     <thead>
      <row>
       <entry>&Version;</entry>
       <entry>&Description;</entry>
      </row>
     </thead>
     <tbody>
      <row>
       <entry>8.0.0</entry>
       <entry>
        <varname>$php_errormsg</varname> उपलब्ध गराउने
        <link linkend="ini.track-errors">track_errors</link> directive
        हटाइएको छ।
       </entry>
      </row>
      <row>
       <entry>7.2.0</entry>
       <entry>
        <varname>$php_errormsg</varname> उपलब्ध गराउने
        <link linkend="ini.track-errors">track_errors</link> directive लाई
        deprecate गरिएको छ।
       </entry>
      </row>
     </tbody>
    </tgroup>
   </informaltable>
  </para>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <para>
   <example xml:id="variable.phperrormsg.basic">
    <title><varname>$php_errormsg</varname> को उदाहरण</title>
    <programlisting role="php">
<![CDATA[
<?php
@strpos();
echo $php_errormsg;
?>
]]>
    </programlisting>
    &example.outputs.similar;
    <screen>
<![CDATA[
Wrong parameter count for strpos()
]]>
    </screen>
   </example>
  </para>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member><function>error_get_last</function></member>
   </simplelist>
  </para>
 </refsect1>

</refentry>

