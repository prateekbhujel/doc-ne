<refentry role="variable" xml:id="reserved.variables.argc" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>$argc</refname>
  <refpurpose>Script मा pass गरिएका arguments को संख्या</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <para>
   <link linkend="features.commandline">Command line</link> बाट चलाउँदा हालको
   script मा pass गरिएका arguments को संख्या यसमा रहन्छ।
  </para>
  <note>
   <simpara>
    Script को filename सधैँ script मा एउटा argument का रूपमा pass हुने भएकाले
    <varname>$argc</varname> को न्यूनतम मान <literal>1</literal> हुन्छ।
   </simpara>
  </note>
  <note>
   <simpara>
    <link linkend="ini.register-argc-argv">register_argc_argv</link> disable
    गरिएको हुँदा यो variable उपलब्ध हुँदैन।
   </simpara>
  </note>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <para>
   <example xml:id="variable.argc.basic">
    <title><varname>$argc</varname> को उदाहरण</title>
    <programlisting role="php">
<![CDATA[
<?php
var_dump($argc);
?>
]]>
    </programlisting>
    <simpara>
     यो उदाहरणलाई यसरी चलाउँदा: php script.php arg1 arg2 arg3
    </simpara>
    &example.outputs.similar;
    <screen>
<![CDATA[
int(4)
]]>
    </screen>
   </example>
  </para>
 </refsect1>

 <refsect1 role="notes">
  &reftitle.notes;
  <note>
   <para>
    यो <varname>$_SERVER['argc']</varname> का रूपमा पनि उपलब्ध हुन्छ।
   </para>
  </note>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member><function>getopt</function></member>
    <member><link linkend="reserved.variables.argv"><varname>$argv</varname></link></member>
   </simplelist>
  </para>
 </refsect1>

</refentry>

