<reference xml:id="class.unitenum" role="class" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xi="http://www.w3.org/2001/XInclude">
 <title>UnitEnum interface</title>
 <titleabbrev>UnitEnum</titleabbrev>

 <partintro>

  <section xml:id="unitenum.intro">
   &reftitle.intro;
   <simpara><classname>UnitEnum</classname> interface लाई engine ले सबै enumerations मा स्वतः लागू गर्छ। यसलाई user-defined classes ले implement गर्न पाउँदैनन्। Enumerations ले यसका methods लाई override गर्न पाउँदैनन्, किनभने engine ले नै default implementations प्रदान गर्छ। यो केवल type checks का लागि मात्र उपलब्ध छ।</simpara>
  </section>

  <section xml:id="unitenum.synopsis">
   &reftitle.interfacesynopsis;

   <classsynopsis class="interface">
    <oointerface>
     <interfacename>UnitEnum</interfacename>
    </oointerface>

    <classsynopsisinfo role="comment">&Methods;</classsynopsisinfo>
    <xi:include xpointer="xmlns(db=http://docbook.org/ns/docbook) xpointer(id('class.unitenum')/db:refentry/db:refsect1[@role='description']/descendant::db:methodsynopsis[@role='UnitEnum'])"/>
   </classsynopsis>

  </section>

 </partintro>

 &language.predefined.unitenum.cases;

</reference>
