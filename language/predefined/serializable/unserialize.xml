<refentry xml:id="serializable.unserialize" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Serializable::unserialize</refname>
  <refpurpose>object construct गर्दछ</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="Serializable">
   <modifier>public</modifier> <type>void</type><methodname>Serializable::unserialize</methodname>
   <methodparam><type>string</type><parameter>data</parameter></methodparam>
  </methodsynopsis>
  <para>object को unserialization गर्दा call गरिन्छ।</para>
  <note>
   <para>यो method ले object को <link linkend="language.oop5.decon.constructor">constructor</link> को रूपमा काम गर्दछ। यो method पछि <link linkend="object.construct">__construct()</link> method call गरिने <emphasis>छैन</emphasis>।</para>
  </note>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <para>
   <variablelist>
    <varlistentry>
     <term><parameter>data</parameter></term>
     <listitem>
      <para>object को string representation।</para>
     </listitem>
    </varlistentry>
   </variablelist>
  </para>

 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>यो method from return value लाई ignore गरिन्छ।</para>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member><link linkend="object.wakeup">__wakeup()</link></member>
    <member><link linkend="object.unserialize">__unserialize()</link></member>
   </simplelist>
  </para>
 </refsect1>

</refentry>
